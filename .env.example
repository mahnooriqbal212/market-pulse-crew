# =====================================================================
# Market Pulse Crew - environment settings
# ---------------------------------------------------------------------
# 1. Copy this file to `.env`      (Windows: copy .env.example .env)
# 2. Fill in your real values.     `.env` is git-ignored: never commit it.
# 3. Check it:                     python src/market_pulse/config.py
# =====================================================================


# =====================================================================
# 1) DEFAULT model  (REQUIRED) - used by every agent unless overridden
# ---------------------------------------------------------------------
# Format: provider/model-name  (LiteLLM style, used by CrewAI's LLM class)
# Free options (check each site for the current free model names):
#   Groq             DEFAULT_LLM_MODEL=groq/llama-3.3-70b-versatile
#   OpenRouter       DEFAULT_LLM_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
#   Google AI Studio DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash
#   Cerebras         DEFAULT_LLM_MODEL=cerebras/llama-3.3-70b
#   Any OpenAI-compatible server: use "openai/<model-name>" + a BASE_URL
# =====================================================================


GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxx

GEMINI_MODEL=openai/gemini-3.5-flash-lite 
HF_DEEPSEEK_MODEL=openai/deepseek-ai/DeepSeek-V4.1-Flash-1017
KIMI_MODEL_HF=openai/moonshotai/Kimi-K3

# ======================================================================

DEFAULT_LLM_MODEL=openai/llama-3.3-70b-versatile
DEFAULT_LLM_API_KEY=${GROQ_API_KEY}
# Optional. Only needed for OpenAI-compatible endpoints, e.g.
#   https://openrouter.ai/api/v1   or   https://api.cerebras.ai/v1
DEFAULT_LLM_BASE_URL=https://api.groq.com/openai/v1


# =====================================================================
# 2) Per-agent overrides  (OPTIONAL) - leave empty to use DEFAULT
# ---------------------------------------------------------------------
# Each empty value falls back to the DEFAULT one.
# If a role uses a DIFFERENT provider than DEFAULT, you must also set
# that role's API_KEY (and BASE_URL if needed). The app will tell you.
# =====================================================================
# Market Researcher (searches + scrapes the web)
RESEARCHER_LLM_MODEL=${GEMINI_MODEL}
RESEARCHER_LLM_API_KEY=${GEMINI_API_KEY}
RESEARCHER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Competitor Analyst (compares competitors)
ANALYST_LLM_MODEL=${HF_DEEPSEEK_MODEL}
ANALYST_LLM_API_KEY=${HF_API_KEY}
ANALYST_LLM_BASE_URL=https://router.huggingface.co/v1

# Report Writer (writes the final Markdown briefing)
WRITER_LLM_MODEL=${KIMI_MODEL_HF}
WRITER_LLM_API_KEY=${HF_API_KEY}
WRITER_LLM_BASE_URL=https://router.huggingface.co/v1


# =====================================================================
# 3) Shared model options  (OPTIONAL) - empty = provider default
# =====================================================================
# 0.0 = focused/factual, 1.0+ = more creative. Allowed: 0.0 - 2.0
LLM_TEMPERATURE=
# Max length of each model answer (in tokens)
LLM_MAX_TOKENS=


# =====================================================================
# 4) Free-tier protection  (OPTIONAL) - defaults shown
# =====================================================================
# Max LLM requests per minute, per agent (lower it if you hit rate limits)
AGENT_MAX_RPM=10
# Max reasoning/tool steps per agent (keeps runs short and cheap)
AGENT_MAX_ITER=8
# How many times to retry after a "rate limit" error
LLM_MAX_RETRIES=3
# Seconds to wait before the 1st retry; doubles each time (10, 20, 40...)
LLM_RETRY_BASE_DELAY=10


# =====================================================================
# 5) Web search
# ---------------------------------------------------------------------
# duckduckgo = free, no key needed (default, good for testing)
# serper     = Google results via serper.dev (limited free credits)
# =====================================================================
SEARCH_PROVIDER=duckduckgo
# Only needed when SEARCH_PROVIDER=serper. Get one at https://serper.dev
SERPER_API_KEY=
# If Serper fails (e.g. credits used up), switch to DuckDuckGo automatically
SEARCH_FALLBACK_TO_DUCKDUCKGO=true
# Search results per query
SEARCH_MAX_RESULTS=5


# =====================================================================
# 6) CrewAI telemetry  (OPTIONAL) - read directly by CrewAI
# =====================================================================
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
